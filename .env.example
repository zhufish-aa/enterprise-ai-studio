# Local development only; production uses a secret manager.
POSTGRES_DB=enterprise_ai_studio
POSTGRES_USER=eas_local
POSTGRES_PASSWORD=
REDIS_PASSWORD=
API_HOST=127.0.0.1
API_PORT=3000
# Optional fixed compiler, disabled when absent. Use secret-manager injection outside local TEST.
BUILD_WORKER_URL=
BUILD_WORKER_KEY=
# Non-local use requires BUILD_CLIENT_TLS_{CA,CERT,KEY} and worker-side mTLS files.

# Optional account/password portal login. HTTPS origin required outside explicit local development.
PLATFORM_PASSWORD_AUTH=false
PLATFORM_PORTAL_ORIGIN=

# API encrypted credential store: provision absolute protected paths and independent TEST/PRODUCTION 32-byte keys.
# CATALOG_TEST_MANAGED_SECRET_DIR=/run/eas-secrets/test
# CATALOG_TEST_MANAGED_SECRET_KEY_FILE=/run/eas-keys/test.key
# CATALOG_PRODUCTION_MANAGED_SECRET_DIR=/run/eas-secrets/production
# CATALOG_PRODUCTION_MANAGED_SECRET_KEY_FILE=/run/eas-keys/production.key
# Corresponding environment connector:
# CATALOG_MANAGED_SECRET_DIR=/run/eas-secrets/test
# CATALOG_MANAGED_SECRET_KEY_FILE=/run/eas-keys/test.key

# Controlled static release service. Production requires DEPLOY_CLIENT_TLS_{CERT,KEY,CA}.
DEPLOY_WORKER_URL=
DEPLOY_WORKER_KEY=
# Worker-side: DEPLOY_ARTIFACT_DIR, DEPLOY_WORKER_PORT, DEPLOY_TLS_{CERT,KEY,CA}.
# Production connector may use a mounted CA only for the fixed configured:database-ca reference:
# CATALOG_DATABASE_CA_FILE=/run/eas-certificates/business-database-ca.pem

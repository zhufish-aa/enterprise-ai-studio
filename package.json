{
  "name": "enterprise-ai-studio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @eas/platform-web --filter @eas/platform-api dev",
    "typecheck": "pnpm --filter ./packages/* --sort build && pnpm -r --sort typecheck",
    "build": "pnpm -r --sort build",
    "contract:generate": "node scripts/generate-contract.mjs",
    "contract:check": "node scripts/generate-contract.mjs --check",
    "schema:check": "node scripts/check-schema.mjs",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm contract:check && pnpm boundaries:check && pnpm deliverables:check && pnpm typecheck && pnpm build && pnpm schema:check && pnpm test",
    "infra:up": "docker compose --env-file .env -f infra/compose.yaml up -d",
    "infra:down": "docker compose --env-file .env -f infra/compose.yaml down",
    "env:init": "node scripts/init-dev-env.mjs",
    "deliverables:check": "node scripts/check-deliverables.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "catalog:configure": "node scripts/configure-catalog.mjs",
    "dev:local": "node scripts/local-catalog.mjs",
    "test:catalog": "node --test --test-concurrency=1 tests/catalog*.test.mjs",
    "test:gateway": "node --test --test-concurrency=1 tests/gateway*.test.mjs",
    "test:studio": "node --test --test-concurrency=1 tests/studio*.test.mjs",
    "test:releases": "node --test tests/releases.integration.test.mjs",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.{ts,tsx,css}\" \"services/*/src/**/*.ts\" \"sites/**/*.{ts,tsx,css}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css}\" \"packages/*/src/**/*.{ts,tsx,css}\" \"services/*/src/**/*.ts\" \"sites/**/*.{ts,tsx,css}\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@electric-sql/pglite": "0.5.11",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "node-forge": "1.4.0",
    "openapi-types": "12.1.3",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "yaml": "2.8.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@embedded-postgres/windows-x64": "18.4.0-beta.17"
  }
}

{
  "name": "@zhujunjie12/harness-plugin",
  "version": "0.3.0",
  "description": "DeepSeek Harness 企业站点与数据集插件：服务器源码编辑、构建预览、远程调试与上线申请。",
  "keywords": [
    "deepseek",
    "harness",
    "cordis",
    "enterprise",
    "sites",
    "reports"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc && tsc -p tsconfig.client.json && node ../../scripts/bundle-harness.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "0.27.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@eas/api-contract": "workspace:*",
    "@eas/platform-sdk": "workspace:*",
    "@eas/shared": "workspace:*",
    "ajv": "8.17.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-time": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "react": "18.3.1",
    "@types/react": "18.3.27",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-directory-picker": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.3",
    "react-dom": "18.3.1",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "workflow.md",
    "skills"
  ],
  "engines": {
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3",
    "node": ">=24 <25"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2 || 0.2.1-rc.3"
  }
}
